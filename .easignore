# PDFs and reference materials
*.pdf

# Design files: exclude the whole source-art tree (303 MB of Figma exports,
# icon working files, etc.) EXCEPT the two splash assets AnimatedSplash.js
# require()s at runtime. .easignore supports negation with "!".
design/*
!design/splash3-canva.json
!design/splash3-canva-static.png
IFS-resources/

# --- Heavy dirs NOT needed to build the app ---
# IMPORTANT: when .easignore exists it REPLACES .gitignore for the upload,
# so gitignored heavy dirs must be re-listed here or they get uploaded.
knowledge-base/
dist/
out/
coverage/
.venv/
scripts/
marketing/
mockups/
__tests__/
.expo/
web-build/
.full-stack-feature/

# Python bytecode
__pycache__/
*.pyc

