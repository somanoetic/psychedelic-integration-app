# =============================================================================
# Huxley - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
#
# For EAS production/preview builds, set these as EAS Secrets instead of
# relying on .env (which only ships with local dev). See the "EAS Secrets"
# section at the bottom of this file.
# =============================================================================

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: SUPABASE_SERVICE_KEY must NEVER be used in client-side code.
# Service role keys bypass Row Level Security and belong only on the server.
# Use Supabase Edge Functions or a backend server for operations requiring
# elevated privileges (e.g., admin metrics insertion).

# =============================================================================
# SECURITY UPDATE (2026-02-10): Anthropic API Key No Longer Needed Client-Side
# =============================================================================
# Claude API is now accessed via Supabase Edge Function proxy for security.
# API keys are stored server-side only as Supabase secrets.
#
# To set the API key on the server:
#   1. Install Supabase CLI: npm install -g supabase
#   2. Link your project: supabase link --project-ref <your-ref>
#   3. Set secret: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# See: .full-stack-feature/SECURITY_FIX_DEPLOYMENT.md for full deployment guide
# =============================================================================
# ANTHROPIC_API_KEY=<no-longer-needed-on-client>

# Sentry (Error Tracking & Performance Monitoring)
# Get your DSN from: https://sentry.io
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Development/Debug Flags
DEBUG_CLAUDE=false

# =============================================================================
# EAS Secrets — Required for production / preview builds
# =============================================================================
# eas.json profiles read these via process.env at build time (same path as
# .env locally). Set them once per project with:
#
#   eas secret:create --scope project --name SUPABASE_URL --value <prod-url>
#   eas secret:create --scope project --name SUPABASE_ANON_KEY --value <prod-key>
#   eas secret:create --scope project --name SENTRY_DSN --value <prod-dsn>
#
# Or via the EAS dashboard: https://expo.dev/accounts/<owner>/projects/<slug>/secrets
#
# For dev/staging vs prod separation (FEAT-401), create a parallel set of
# secrets pointing at the huxley-prod Supabase project + a separate Sentry
# project for prod traffic, and switch via EAS build profile.
#
# DEBUG_CLAUDE is non-secret and lives in eas.json directly (true for
# development profile, false for preview + production).
# =============================================================================
